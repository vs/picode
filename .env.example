# Example environment for Picode. Copy to .env and fill in real values; .env is git-ignored.
# All values below are placeholders.

# --- picode-scraper -----------------------------------------------------------------------
# Every scraper setting can be overridden as PICODE_<SECTION>__<KEY> (see configs/default.yaml).

# Config file path (same as -c/--config). The Docker image sets /app/configs/default.yaml.
PICODE_CONFIG=configs/default.yaml

# PostgreSQL (or sqlite:///path.db for single-worker local runs)
PICODE_DATABASE__URL=postgresql://picode:change-me@localhost:5432/picode_scraper
PICODE_DATABASE__POOL_SIZE=5

# Storage backend: local or s3
PICODE_STORAGE__BACKEND=local
PICODE_STORAGE__LOCAL_PATH=/data/images
PICODE_STORAGE__S3_BUCKET=
PICODE_STORAGE__S3_PREFIX=images
PICODE_STORAGE__S3_ENDPOINT_URL=

# HTTP behavior
PICODE_SCRAPING__USER_AGENT=PicodeDatasetCollector/1.0 (research)
PICODE_SCRAPING__REQUEST_DELAY=1.0
PICODE_SCRAPING__MAX_RETRIES=3
PICODE_SCRAPING__TIMEOUT=30
PICODE_SCRAPING__PROXY_URL=
PICODE_SCRAPING__PROXY_ROTATION=false

# Pair validation thresholds
PICODE_VALIDATION__MIN_IMAGE_SIZE=256
PICODE_VALIDATION__MIN_CORNER_CONFIDENCE=0.7
PICODE_VALIDATION__MIN_COVERAGE=0.1
PICODE_VALIDATION__MIN_SIMILARITY=0.6
PICODE_VALIDATION__PROXY_RESOLUTION=800

# S3 credentials (standard boto3 variables; only needed with the s3 backend)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# --- picode-model cloud runners -----------------------------------------------------------
# Lightning.ai (scripts/lightning_runner.py)
LIGHTNING_USERNAME=your-lightning-username
LIGHTNING_API_KEY=your-lightning-api-key

# Kaggle kernel entry point (scripts/kaggle/kaggle_train.py): which model config to train
MODEL_NAME=picodeframe

# Modal, GCE and Kaggle uploads authenticate via their own CLIs
# (`modal token new`, `gcloud auth login`, ~/.kaggle/kaggle.json), not via this file.
